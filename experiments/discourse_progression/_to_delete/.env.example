# 이 파일을 복사해서 같은 폴더에 ".env"로 저장하고 값을 채우세요.
#   copy .env.example .env   (Windows)
# .env는 .gitignore에 걸려 있어 커밋되지 않습니다 — 키를 절대 커밋하지 마세요.

# 필수: API 키
OPENAI_API_KEY=sk-여기에
GEMINI_API_KEY=여기에

# 모델 ID — 발급받은 키로 실제 사용 가능한 모델명 확인 후 수정
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-pro

# judge 모델 (생략 시 OPENAI_MODEL과 동일)
# JUDGE_MODEL=gpt-5
