{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "belief1-coding-output.schema.json",
  "title": "Belief-1 blind coding output",
  "type": "object",
  "required": ["pack", "coder_id", "coder_family", "instruction_version", "independent", "key_access", "source_path", "source_sha256", "items"],
  "properties": {
    "pack": {"enum": ["PACK_A", "PACK_B", "PACK_C"]},
    "coder_id": {"type": "string", "minLength": 1},
    "coder_family": {"enum": ["Hermes-Sol", "Claude", "Adjudicator"]},
    "instruction_version": {"const": "20260831-v1"},
    "independent": {"type": "boolean"},
    "key_access": {"const": false},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assigned_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": ["string", "null"]},
    "items": {"type": "array", "minItems": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"pack": {"const": "PACK_A"}}},
      "then": {
        "properties": {
          "items": {
            "minItems": 66,
            "maxItems": 66,
            "items": {"$ref": "#/$defs/aItem"}
          }
        }
      }
    },
    {
      "if": {"properties": {"pack": {"const": "PACK_B"}}},
      "then": {
        "properties": {"items": {"items": {"$ref": "#/$defs/bItem"}}}
      }
    },
    {
      "if": {"properties": {"pack": {"const": "PACK_C"}}},
      "then": {
        "properties": {
          "items": {
            "minItems": 33,
            "maxItems": 33,
            "items": {"$ref": "#/$defs/cItem"}
          }
        }
      }
    }
  ],
  "$defs": {
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "quote": {"type": "string", "minLength": 1},
    "aItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "q1_orientation", "q2_politics", "q3_beliefs", "evidence", "confidence", "ambiguity_note"],
      "properties": {
        "id": {"type": "string", "pattern": "^A-(0[1-9]|[1-5][0-9]|6[0-6])$"},
        "q1_orientation": {"enum": ["사람 사정 먼저", "정한 것 지킴", "모르겠다"]},
        "q2_politics": {"enum": ["좌파", "우파", "모르겠다"]},
        "q3_beliefs": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 12}, "uniqueItems": true},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["q1", "q2", "q3"],
          "properties": {
            "q1": {"$ref": "#/$defs/quote"},
            "q2": {"$ref": "#/$defs/quote"},
            "q3": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/quote"}
            }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["q1", "q2", "q3"],
          "properties": {"q1": {"$ref": "#/$defs/confidence"}, "q2": {"$ref": "#/$defs/confidence"}, "q3": {"$ref": "#/$defs/confidence"}}
        },
        "ambiguity_note": {"type": ["string", "null"]}
      }
    },
    "bFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_no", "retained", "evidence", "rationale", "confidence"],
      "properties": {
        "fact_no": {"type": "integer", "minimum": 1, "maximum": 12},
        "retained": {"type": "boolean"},
        "evidence": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "bItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "facts", "ambiguity_note"],
      "properties": {
        "id": {"type": "string", "pattern": "^B-(0[1-9]|[1-5][0-9]|6[0-6])$"},
        "facts": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/bFact"}},
        "ambiguity_note": {"type": ["string", "null"]}
      }
    },
    "roundOption": {"type": "object", "additionalProperties": false, "required": ["r0", "r1", "r2", "r3"], "properties": {"r0": {"type": "string"}, "r1": {"type": "string"}, "r2": {"type": "string"}, "r3": {"type": "string"}}},
    "cItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "round_options", "conclusion_relation", "first_flip", "change_type", "evidence", "confidence", "ambiguity_note"],
      "properties": {
        "id": {"type": "string", "pattern": "^C-(0[1-9]|[12][0-9]|3[0-3])$"},
        "round_options": {"$ref": "#/$defs/roundOption"},
        "conclusion_relation": {"enum": ["유지", "바뀜", "모르겠다"]},
        "first_flip": {"type": ["string", "null"], "enum": ["r1", "r2", "r3", null]},
        "change_type": {"type": ["string", "null"], "enum": ["설득", "오락가락", "모르겠다", null]},
        "evidence": {"type": "object", "additionalProperties": false, "required": ["r0", "decisive"], "properties": {"r0": {"$ref": "#/$defs/quote"}, "decisive": {"$ref": "#/$defs/quote"}}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "ambiguity_note": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"conclusion_relation": {"const": "바뀜"}}}, "then": {"properties": {"first_flip": {"enum": ["r1", "r2", "r3"]}, "change_type": {"enum": ["설득", "오락가락", "모르겠다"]}}}},
        {"if": {"properties": {"conclusion_relation": {"enum": ["유지", "모르겠다"]}}}, "then": {"properties": {"first_flip": {"const": null}, "change_type": {"const": null}}}}
      ]
    }
  }
}
