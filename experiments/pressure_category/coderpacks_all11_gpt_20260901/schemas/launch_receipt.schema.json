{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "launch_nonce", "executable", "arguments", "requested_identity", "provider_resolved_identity", "pid", "ppid", "process_create_time", "bundle_path", "bundle_sha256", "input_sha256", "session_id", "provider_request_id", "provider_auxiliary_models", "resumed", "runtime_controls", "started_at", "ended_at", "exit_code", "stdout_sha256", "stderr_sha256", "output_sha256", "preexisting_family_pids", "fresh_process"],
  "properties": {
    "schema": {"const": "all11_gpt_launch_receipt_v2"},
    "launch_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "executable": {"type": "string", "minLength": 1},
    "arguments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "requested_identity": {"$ref": "#/$defs/requestedIdentity"},
    "provider_resolved_identity": {"$ref": "#/$defs/resolvedIdentity"},
    "pid": {"type": "integer", "minimum": 1},
    "ppid": {"type": "integer", "minimum": 1},
    "process_create_time": {"type": "number", "exclusiveMinimum": 0},
    "bundle_path": {"type": "string", "minLength": 1},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "session_id": {"type": "string", "minLength": 1},
    "provider_request_id": {"type": "string", "minLength": 1},
    "provider_auxiliary_models": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resumed": {"const": false},
    "runtime_controls": {"$ref": "#/$defs/runtimeControls"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "exit_code": {"const": 0},
    "stdout_sha256": {"$ref": "#/$defs/sha256"},
    "stderr_sha256": {"$ref": "#/$defs/sha256"},
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "preexisting_family_pids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "fresh_process": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requestedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "model", "provider"],
      "properties": {
        "family": {"enum": ["Claude", "Hermes-Sol"]},
        "model": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1}
      }
    },
    "resolvedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "model", "provider", "source"],
      "properties": {
        "family": {"enum": ["Claude", "Hermes-Sol"]},
        "model": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "source": {"const": "provider-response"}
      }
    },
    "runtimeControls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools_sent", "tool_choice", "mcp_servers", "session_persistence", "agent_loop"],
      "properties": {
        "tools_sent": {"const": 0},
        "tool_choice": {"const": "none"},
        "mcp_servers": {"const": 0},
        "session_persistence": {"const": false},
        "agent_loop": {"const": false}
      }
    }
  }
}
