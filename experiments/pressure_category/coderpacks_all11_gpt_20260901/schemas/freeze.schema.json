{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_at",
    "pack_freezes",
    "coder_output_sha256",
    "consensus_sha256",
    "launch_receipt_sha256",
    "unresolved_fields",
    "key_released"
  ],
  "properties": {
    "schema": {
      "const": "all11_gpt_freeze_v1"
    },
    "created_at": {
      "type": "string"
    },
    "pack_freezes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PACK_A",
        "PACK_B",
        "PACK_C"
      ],
      "properties": {
        "PACK_A": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "PACK_B": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "PACK_C": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "coder_output_sha256": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "consensus_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PACK_A",
        "PACK_B",
        "PACK_C"
      ],
      "properties": {
        "PACK_A": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "PACK_B": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "PACK_C": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "launch_receipt_sha256": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "unresolved_fields": {
      "type": "integer",
      "minimum": 0
    },
    "key_released": {
      "const": false
    }
  }
}
