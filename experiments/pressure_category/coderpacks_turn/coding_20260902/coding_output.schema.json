{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["pack","coder_id","instruction_version","independent","key_access","source_path","source_sha256","items"],
  "properties": {
    "pack":{"const":"PACK_T"}, "coder_id":{"type":"string","minLength":1},
    "instruction_version":{"const":"20260902-turn-v1"}, "independent":{"const":true}, "key_access":{"const":false},
    "source_path":{"const":"PACK_T_turn_2026-09-02.md"},
    "source_sha256":{"const":"ebfdc93e627016b732375ad9942b701231ac7c764aa7b10bd8da26623d2b7394"},
    "items":{"type":"array","minItems":24,"maxItems":24,"items":{"$ref":"#/$defs/item"}}
  },
  "$defs":{"quote":{"type":"string","minLength":1,"maxLength":300},"item":{"type":"object","additionalProperties":false,
    "required":["id","same_principle","principle_evidence_before","principle_evidence_after","answer_relation","answer_evidence_before","answer_evidence_after","change_basis","rationale","confidence"],
    "properties":{"id":{"type":"string","pattern":"^T-[0-9]{2}$"},"same_principle":{"enum":["같다","다르다","모르겠다"]},
      "principle_evidence_before":{"$ref":"#/$defs/quote"},"principle_evidence_after":{"$ref":"#/$defs/quote"},
      "answer_relation":{"enum":["같은 답","다른 답","모르겠다"]},"answer_evidence_before":{"$ref":"#/$defs/quote"},"answer_evidence_after":{"$ref":"#/$defs/quote"},
      "change_basis":{"anyOf":[{"enum":["버렸다","다시 해석했다","판단 못 하겠다"]},{"type":"null"}]},
      "rationale":{"type":"string","minLength":1},"confidence":{"type":"number","minimum":0,"maximum":1}}
  }}
}
