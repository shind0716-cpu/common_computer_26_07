# 복사해서 .env로 저장하고 본인 키 입력. .env는 절대 커밋하지 말 것.
ANTHROPIC_API_KEY=sk-ant-...

# --- 담화 전진 가설 정식 검증 (experiments/discourse_progression) 추가분 ---
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
# 모델 ID — 발급 키로 실제 사용 가능한 모델명 확인 후 수정
OPENAI_MODEL=gpt-5.4-mini
GEMINI_MODEL=gemini-3-flash-preview
# judge 모델 — 생성보다 급을 낮추지 않기 (채점 78회뿐이라 1~2달러 수준)
JUDGE_MODEL=gpt-5.4-mini
